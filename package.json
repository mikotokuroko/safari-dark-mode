{
  "name": "safari-dark-mode",
  "version": "0.1.0",
  "private": true,
  "description": "A focused Safari 26 extension powered by Dark Reader's rendering engine.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "fixtures": "node scripts/fixture-server.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "darkreader": "^4.9.135"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "<6.1.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
